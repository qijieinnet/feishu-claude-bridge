{
  "name": "feishu-claude-bridge",
  "version": "0.2.1",
  "type": "module",
  "description": "把飞书机器人桥接到本机 Claude Code：聊天驱动、卡片审批、会话与模型切换",
  "keywords": [
    "feishu",
    "lark",
    "claude",
    "claude-code",
    "claude-agent-sdk",
    "bot",
    "bridge",
    "飞书",
    "机器人"
  ],
  "license": "MIT",
  "author": "qijieinnet",
  "homepage": "https://github.com/qijieinnet/feishu-claude-bridge#readme",
  "bugs": {
    "url": "https://github.com/qijieinnet/feishu-claude-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qijieinnet/feishu-claude-bridge.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "feishu-claude-bridge": "bin/cli.js",
    "fcb": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "start": "node bin/cli.js start",
    "setup": "node bin/cli.js setup",
    "doctor": "node bin/cli.js doctor",
    "pair": "node bin/cli.js pair",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "@larksuiteoapi/node-sdk": "^1.54.0",
    "dotenv": "^17.2.3",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
