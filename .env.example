# 飞书应用凭证：跑 `npm run setup` 扫码后会自动填好这三项，一般不用手改
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_DOMAIN=feishu

# owner 名单（setup 会自动填入你自己）。其他人通过 `npm run pair -- approve` 授权
# 留空且无配对用户 = 拒绝所有人（安全默认）
FEISHU_ALLOW_FROM=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 每个飞书会话默认的工作目录。只有这里及其子目录会被绑定
BRIDGE_WORKSPACE_ROOT=/path/to/your/projects

# 审批等待超时（毫秒），超时按 deny 处理
BRIDGE_APPROVAL_TIMEOUT_MS=1800000

# 默认模型，留空用 Claude Code 默认
BRIDGE_DEFAULT_MODEL=

# 会话闲置多久作废（毫秒），默认 12 小时
BRIDGE_SESSION_TTL_MS=43200000
